{
  "name": "konterku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "pnpm prisma:generate && next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "build": "pnpm prisma:generate && next build",
    "build:extension": "node scripts/package-extension.js",
    "start": "node .next/standalone/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
