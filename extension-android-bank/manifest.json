{
  "manifest_version": 2,
  "name": "KONTERKU Mobile Bank Connector",
  "version": "1.0.0",
  "description": "Konektor lokal Firefox Android untuk membaca saldo KlikBCA dan IB BRI ke KONTERKU.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bank-connector@konterku.local",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://*.klikbca.com/*",
    "https://*.bri.co.id/*",
    "http://192.168.*.*/*",
    "http://10.*.*.*/*",
    "http://172.16.*.*/*",
    "http://172.17.*.*/*",
    "http://172.18.*.*/*",
    "http://172.19.*.*/*",
    "http://172.20.*.*/*",
    "http://172.21.*.*/*",
    "http://172.22.*.*/*",
    "http://172.23.*.*/*",
    "http://172.24.*.*/*",
    "http://172.25.*.*/*",
    "http://172.26.*.*/*",
    "http://172.27.*.*/*",
    "http://172.28.*.*/*",
    "http://172.29.*.*/*",
    "http://172.30.*.*/*",
    "http://172.31.*.*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "KONTERKU Bank Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.klikbca.com/*",
        "https://*.bri.co.id/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
